# ── Base de datos ──
# Local: usar localhost. Docker: lo genera docker-compose desde POSTGRES_PASSWORD
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/porra_mundial"

# Docker Compose: contraseña de PostgreSQL
POSTGRES_PASSWORD="cambiame_password_seguro"

# ── NextAuth ──
NEXTAUTH_SECRET="replace-with-a-secure-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ── Seed ──
# El super admin inicial se fuerza a pulete@gmail.com / Casita10 en el arranque.

# ── Email (opcional) ──
RESEND_API_KEY=""
EMAIL_FROM="Porra Mundial <noreply@example.com>"

# ── Football Data API (opcional) ──
# Obtener clave gratuita en https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=""
