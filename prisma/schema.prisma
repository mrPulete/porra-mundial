generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum LeagueRole {
  OWNER
  MEMBER
}

enum MatchStage {
  GROUP
  ROUND_OF_32
  ROUND_OF_16
  QUARTER_FINAL
  SEMI_FINAL
  THIRD_PLACE
  FINAL
}

enum RankingScope {
  GLOBAL
  LEAGUE
}

enum ScoringRuleType {
  EXACT_SCORE
  OUTCOME_1X2
  SINGLE_TEAM_GOALS
  QUALIFIED_TEAM
  CHAMPION_PREDICTION
  ROUND_NO_CHANGES_BONUS
}

enum PredictionChangeType {
  MATCH_SUBMIT
  MATCH_EDIT
  BONUS_SUBMIT
  BONUS_EDIT
}

enum PenaltyTarget {
  MATCH_EDIT
  KNOCKOUT_EDIT
  CHAMPION_EDIT
}

model User {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  passwordHash    String
  role            UserRole         @default(USER)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  predictions     MatchPrediction[]
  bonusAnswers    BonusAnswer[]
  rankings        Ranking[]
  leaguesOwned    League[]
  leagueMembers   LeagueMember[]
  leagueDrafts    UserLeagueDraft[]
  officialSubmissions OfficialSubmission[]
  accounts        Account[]
  sessions        Session[]
  predictionHistory PredictionHistory[]
}

model Team {
  id           String  @id @default(cuid())
  name         String
  code         String  @unique
  flagEmoji    String
  homeMatches  Match[] @relation("HomeTeam")
  awayMatches  Match[] @relation("AwayTeam")
  qualifiedPredictions MatchPrediction[] @relation("PredictedQualifiedTeam")
}

model Match {
  id              String            @id @default(cuid())
  stage           MatchStage
  group           String?
  excelCode       String?
  roundOrder      Int
  kickoffAt       DateTime
  homeTeamId      String
  awayTeamId      String
  homeScore       Int?
  awayScore       Int?
  qualifiedTeamId String?
  isFinished      Boolean           @default(false)
  bonusMultiplier Int               @default(1)
  lockAt          DateTime
  homeTeam        Team              @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam        Team              @relation("AwayTeam", fields: [awayTeamId], references: [id])
  predictions     MatchPrediction[]
  predictionHistory PredictionHistory[]

  @@index([stage, roundOrder])
}

model MatchPrediction {
  id               String   @id @default(cuid())
  userId           String
  matchId          String
  leagueId         String?
  predictedOutcome String?
  predictedHome    Int
  predictedAway    Int
  predictedQualifiedTeamId String?
  pointsAwarded    Int      @default(0)
  penaltyPoints    Int      @default(0)
  accuracy         Float?   
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])
  match            Match    @relation(fields: [matchId], references: [id])
  league           League?  @relation(fields: [leagueId], references: [id])
  predictedQualifiedTeam Team? @relation("PredictedQualifiedTeam", fields: [predictedQualifiedTeamId], references: [id])

  @@unique([userId, matchId, leagueId])
}

model StageScoring {
  id          String     @id @default(cuid())
  stage       MatchStage @unique
  oneXTwo     Int        @default(1)
  updatedAt   DateTime   @updatedAt
}

model BonusQuestion {
  id            String        @id @default(cuid())
  question      String
  code          String?
  options       Json
  points        Int           @default(0)
  deadline      DateTime
  correctAnswer Json?
  answers       BonusAnswer[]
  history       PredictionHistory[]
}

model BonusAnswer {
  id             String        @id @default(cuid())
  userId         String
  questionId     String
  leagueId       String?
  answer         Json
  pointsAwarded  Int           @default(0)
  penaltyPoints  Int           @default(0)
  user           User          @relation(fields: [userId], references: [id])
  question       BonusQuestion @relation(fields: [questionId], references: [id])
  league         League?       @relation(fields: [leagueId], references: [id])

  @@unique([userId, questionId, leagueId])
}

model Ranking {
  id            String       @id @default(cuid())
  userId        String
  scope         RankingScope @default(GLOBAL)
  leagueId      String?
  totalPoints   Int          @default(0)
  exactHits     Int          @default(0)
  accuracy      Float        @default(0)
  rankPosition  Int          @default(0)
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id])
  league        League?      @relation(fields: [leagueId], references: [id])

  @@unique([userId, scope, leagueId])
}

model League {
  id               String            @id @default(cuid())
  name             String
  code             String            @unique
  ownerId          String
  createdAt        DateTime          @default(now())
  owner            User              @relation(fields: [ownerId], references: [id])
  members          LeagueMember[]
  rankings         Ranking[]
  matchPredictions MatchPrediction[]
  bonusAnswers     BonusAnswer[]
  scoringRules     ScoringRule[]
  bonusRules       BonusRule[]
  penaltyRules     PenaltyRule[]
  predictionHistory PredictionHistory[]
  userDrafts       UserLeagueDraft[]
  officialSubmissions OfficialSubmission[]
}

model UserLeagueDraft {
  id          String   @id @default(cuid())
  userId      String
  leagueId    String
  matchDrafts Json?
  bonusDrafts Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  league      League   @relation(fields: [leagueId], references: [id])

  @@unique([userId, leagueId])
  @@index([leagueId, updatedAt])
}

model OfficialSubmission {
  id            String   @id @default(cuid())
  userId        String
  leagueId      String
  version       Int
  submittedAt   DateTime @default(now())
  changesCount  Int      @default(0)
  penaltyApplied Int     @default(0)
  matchSnapshot Json
  bonusSnapshot Json
  user          User     @relation(fields: [userId], references: [id])
  league        League   @relation(fields: [leagueId], references: [id])

  @@unique([userId, leagueId, version])
  @@index([leagueId, submittedAt])
  @@index([userId, leagueId, submittedAt])
}

model ScoringRule {
  id        String          @id @default(cuid())
  leagueId  String
  stage     MatchStage
  ruleType  ScoringRuleType
  points    Int
  enabled   Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  league    League          @relation(fields: [leagueId], references: [id])

  @@unique([leagueId, stage, ruleType])
}

model BonusRule {
  id        String   @id @default(cuid())
  leagueId  String
  code      String
  label     String
  points    Int
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  league    League   @relation(fields: [leagueId], references: [id])

  @@unique([leagueId, code])
}

model PenaltyRule {
  id        String        @id @default(cuid())
  leagueId  String
  target    PenaltyTarget
  points    Int
  enabled   Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  league    League        @relation(fields: [leagueId], references: [id])

  @@unique([leagueId, target])
}

model PredictionHistory {
  id          String               @id @default(cuid())
  leagueId    String
  userId      String
  matchId     String?
  questionId  String?
  changeType  PredictionChangeType
  oldValue    Json?
  newValue    Json
  penaltyApplied Int               @default(0)
  createdAt   DateTime             @default(now())
  user        User                 @relation(fields: [userId], references: [id])
  league      League               @relation(fields: [leagueId], references: [id])
  match       Match?               @relation(fields: [matchId], references: [id])
  question    BonusQuestion?       @relation(fields: [questionId], references: [id])

  @@index([leagueId, createdAt])
  @@index([userId, createdAt])
}

model LeagueMember {
  id         String     @id @default(cuid())
  leagueId   String
  userId     String
  role       LeagueRole @default(MEMBER)
  joinedAt   DateTime   @default(now())
  league     League     @relation(fields: [leagueId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([leagueId, userId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model TeamFootballData {
  id          String   @id @default(cuid())
  teamCode    String   @unique
  data        Json
  fetchedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
